# Copy to .env and adjust as needed.

# SQLAlchemy URL. Relative SQLite paths resolve from backend/, wherever uvicorn is started.
DATABASE_URL=sqlite:///./data/cliniccare.db

# Log every SQL statement (useful while debugging).
SQL_ECHO=false

# Comma-separated list of origins allowed to call the API (the Nuxt dev server by default).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Secret used to sign access tokens, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random secret is generated at startup and tokens stop working after a restart.
# JWT_SECRET=

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Demo doctor account, created at startup if the username does not exist yet.
# Leave DEMO_DOCTOR_USERNAME empty to skip it. Change these outside local development.
DEMO_DOCTOR_USERNAME=doctor
DEMO_DOCTOR_PASSWORD=doctor123
DEMO_DOCTOR_FULL_NAME=Dr. Demo

# Sample consultations for the demo doctor, added once while there are no consultations yet.
DEMO_CONSULTATIONS=true
