# Copy to .env and adjust as needed.

# SQLAlchemy URL. Relative SQLite paths resolve from the directory uvicorn runs in.
DATABASE_URL=sqlite:///./cliniccare.db

# Log every SQL statement (useful while debugging).
SQL_ECHO=false

# Comma-separated list of origins allowed to call the API (the Nuxt dev server by default).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
