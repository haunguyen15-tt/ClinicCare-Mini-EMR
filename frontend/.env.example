# Copy to .env and adjust as needed.

# Base URL of the FastAPI backend, as seen from the Nuxt server. The browser never calls it
# directly: it goes through this app's /api routes, which add the token from the cookie.
NUXT_API_BASE=http://localhost:8000

# Mark the token cookie `Secure` (HTTPS only). Leave off for plain-http local runs.
NUXT_COOKIE_SECURE=false
